# Circle User-Controlled Wallets email OTP / social login
# Create these in Circle Console > Wallets > User Controlled > Configurator.
NEXT_PUBLIC_CIRCLE_APP_ID=
CIRCLE_API_KEY=

# Google OAuth Web client ID for social login (Circle Console > Social Logins).
# Also configure the same redirect URI (your app origin) in Google Cloud Console.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional. Defaults to SCA. Use EOA if Arc SCA is unavailable for your Circle project.
CIRCLE_WALLET_ACCOUNT_TYPE=SCA
OPENAI_API_KEY=your_openai_api_key

# Optional server-side Arc RPC override. The agent falls back across Arc's
# documented public providers when this is unset or temporarily unavailable.
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network

# ── Telegram Integration ─────────────────────────────────────────────────
# Bot token from @BotFather. Server-side only.
TELEGRAM_BOT_TOKEN=
# WalletConnect Project ID from https://cloud.reown.com (free). Public.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Shared secret the Telegram bot sends as x-api-key when calling /api/agent.
BOT_API_KEY=
# Upstash Redis REST URL + token (https://console.upstash.com, free tier).
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=
