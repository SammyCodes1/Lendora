# Circle User-Controlled Wallets email OTP / social login
NEXT_PUBLIC_CIRCLE_APP_ID=
CIRCLE_API_KEY=
CIRCLE_WALLET_ACCOUNT_TYPE=SCA

# Google OAuth Web client ID for Sign in with Google.
# Create an OAuth 2.0 Web client in Google Cloud Console, then paste the same
# client ID into Circle Console > Wallets > User Controlled > Social Logins.
# Authorized redirect URI must be the exact origin, with no trailing slash:
#   http://localhost:3000
#   https://www.arclend.cv
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
