# Circle User-Controlled Wallets email OTP / social login
NEXT_PUBLIC_CIRCLE_APP_ID=
CIRCLE_API_KEY=
CIRCLE_WALLET_ACCOUNT_TYPE=SCA

# Google OAuth Web client ID for Sign in with Google.
# 1. Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Web client
# 2. Paste the SAME client ID into Circle Console > Wallets > User Controlled >
#    Configurator > Social Logins > Google.
# 3. Authorized JavaScript origins AND Authorized redirect URIs must include
#    these exact values, with no trailing slash:
#      http://localhost:3000
#      https://www.arclend.cv
#    "Access blocked / app request is invalid" is almost always a missing URI.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
