# Telegram bot token from @BotFather. Server-side only.
TELEGRAM_BOT_TOKEN=REDACTED
# Shared secret matching BOT_API_KEY in the Vercel/Next.js env. The bot sends
# this as x-api-key when calling /api/agent.
BOT_API_KEY=REDACTED

# Upstash Redis REST URL + token (https://console.upstash.com, free tier).
UPSTASH_REDIS_URL=REDACTED
UPSTASH_REDIS_TOKEN=REDACTED

# Public URL of the deployed Next.js app (the Mini App + /api/agent live here).
NEXT_PUBLIC_APP_URL=https://arclend-alpha.vercel.app
